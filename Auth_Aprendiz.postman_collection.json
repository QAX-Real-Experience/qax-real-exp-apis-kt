  },
  "item": [
    {
      "name": "1. Login exitoso",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let jsonData = pm.response.json();",
              "if (jsonData.access_token) pm.collectionVariables.set('accessToken', jsonData.access_token);",
              "if (jsonData.refresh_token) pm.collectionVariables.set('refreshToken', jsonData.refresh_token);",
              "if (jsonData.user && jsonData.user.id) pm.collectionVariables.set('userId', jsonData.user.id);",
              "pm.test('Login exitoso', function () {",
              "  pm.expect(pm.response.code).to.eql(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "apikey",
            "value": "{{apiKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/v1/token?grant_type=password",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "v1",
            "token"
          ],
          "query": [
            {
              "key": "grant_type",
              "value": "password"
            }
          ]
        },
        "description": "Realiza login del aprendiz usando Supabase Auth.\n\n## Propósito\nObtener `access_token` y `refresh_token` para consumir los endpoints protegidos.\n\n## Endpoint\n`POST /auth/v1/token?grant_type=password`\n\n## Post-script\nGuarda automáticamente:\n- `accessToken`\n- `refreshToken`\n- `userId`"
      },
      "response": []
    },
